{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hacp.example/schemas/v0.3-candidate/common-defs.schema.json",
  "title": "HACP v0.3 Candidate Common Definitions",
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "stringSet": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "canonicalization", "digestDomain", "value"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "canonicalization": { "const": "json-rfc8785-jcs" },
        "digestDomain": {
          "enum": [
            "org.hacp.task-packet.v0.3-candidate",
            "org.hacp.human-decision.v0.3-candidate",
            "org.hacp.consumption-receipt.v0.3-candidate",
            "org.hacp.continuation-context.v0.3-candidate",
            "org.hacp.agent-report.v0.3-candidate",
            "org.hacp.review-finding.v0.3-candidate",
            "org.hacp.stop-response.v0.3-candidate",
            "org.hacp.successor-start-evidence.v0.3-candidate"
          ]
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "digestRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "digest"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "decisionRequestRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "digest"],
      "properties": {
        "kind": { "enum": ["review_finding", "stop_response"] },
        "id": { "$ref": "#/$defs/identifier" },
        "digest": { "$ref": "#/$defs/digest" }
      },
      "oneOf": [
        {
          "properties": {
            "kind": { "const": "review_finding" },
            "digest": {
              "allOf": [
                { "$ref": "#/$defs/digest" },
                { "type": "object", "properties": { "digestDomain": { "const": "org.hacp.review-finding.v0.3-candidate" } } }
              ]
            }
          }
        },
        {
          "properties": {
            "kind": { "const": "stop_response" },
            "digest": {
              "allOf": [
                { "$ref": "#/$defs/digest" },
                { "type": "object", "properties": { "digestDomain": { "const": "org.hacp.stop-response.v0.3-candidate" } } }
              ]
            }
          }
        }
      ]
    }
  }
}
