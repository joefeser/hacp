{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hacp.example/schemas/v0.1-draft/evidence-set.schema.json",
  "title": "HACP v0.1 Draft Evidence Set",
  "description": "Draft record shape for a stable, reviewable collection of evidence references.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "hacp_version",
    "record_kind",
    "evidence_set_id",
    "profile_id",
    "profile_version",
    "created_at",
    "created_by",
    "packet_id",
    "evidence_items",
    "provenance",
    "redaction",
    "linked_records"
  ],
  "properties": {
    "hacp_version": { "const": "v0.1-draft" },
    "record_kind": { "const": "hacp.evidence_set" },
    "evidence_set_id": { "type": "string", "minLength": 1 },
    "profile_id": { "const": "hacp-base-draft" },
    "profile_version": { "const": "v0.1-draft" },
    "created_at": { "type": "string", "format": "date-time" },
    "created_by": { "type": "string", "minLength": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "linked_records": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report_ids", "decision_ids", "finding_ids"],
      "properties": {
        "report_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "decision_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "finding_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "evidence_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_ref", "kind", "summary"],
        "properties": {
          "evidence_ref": { "type": "string", "minLength": 1 },
          "kind": {
            "enum": [
              "command_output",
              "file_diff",
              "audit_event",
              "decision_record",
              "review_comment",
              "evidence_index",
              "other"
            ]
          },
          "summary": { "type": "string", "minLength": 1 },
          "digest": {
            "type": "object",
            "additionalProperties": false,
            "required": ["algorithm", "value"],
            "properties": {
              "algorithm": { "type": "string", "minLength": 1 },
              "value": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_ref", "captured_at"],
        "properties": {
          "source_ref": { "type": "string", "minLength": 1 },
          "captured_at": { "type": "string", "format": "date-time" },
          "note": { "type": "string", "minLength": 1 }
        }
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contains_sensitive_content", "redaction_note"],
      "properties": {
        "contains_sensitive_content": { "type": "boolean" },
        "redaction_note": { "type": "string", "minLength": 1 }
      }
    }
  }
}
